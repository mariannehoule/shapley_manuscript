@article{paltrinieri_effects_nodate,
	title = {The effects of climate on bat morphology across space and time},
	volume = {n/a},
	issn = {1600-0587},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/ecog.07663},
	doi = {10.1002/ecog.07663},
	abstract = {According to Bergmann's and Allen's rules, climate change may drive morphological shifts in species, affecting body size and appendage length. These rules predict that species in colder climates tend to be larger and have shorter appendages to improve thermoregulation. Bats are thought to be sensitive to climate and are therefore expected to respond to climatic changes across space and time. We conducted a phylogenetic meta-analysis on {\textgreater} 27 000 forearm length (FAL) and body mass (BM) measurements from 20 sedentary European bat species to examine body size patterns. We assessed the relationships between body size and environmental variables (winter and summer temperatures, and summer precipitation) across geographic locations, and also analysed temporal trends in body size. We found sex-specific morphological shifts in the body size of European bats in response to temperature and precipitation patterns across space, but no clear temporal changes due to high interspecific variability. Across Europe, male FAL decreased with increasing summer and winter temperatures, and BM increased with greater precipitation. In contrast, both FAL and BM of female bats increased with summer precipitation and decreased with winter temperatures. Our data can confirm Bergmann's rule for both males and females, while females' BM variations are also related to summer precipitation, suggesting a potential link to resource availability. Allen's rule is confirmed only in males in relation to summer temperature, while in females FAL and BM decrease proportionally with increasing temperature, maintaining a constant allometric relationship incompatible with Allen's rule. This study provides new insights into sex and species-dependent morphological changes in bat body size in response to temperature and precipitation patterns. It highlights how body size variation reflects adaptations to temperature and precipitation patterns, thus providing insights into potential species-level morphological responses to climate change across Europe.},
	language = {en},
	number = {n/a},
	urldate = {2025-04-22},
	journal = {Ecography},
	author = {Paltrinieri, Laura and Razgour, Orly and Santini, Luca and Russo, Danilo and Aihartza, Joxerra and Aizpurua, Ostaizka and Amorim, Francisco and Ancillotto, Leonardo and Bidziński, Konrad and Bilgin, Rasit and Briggs, Philip and Cantù-Salazar, Lisette and Ciechanowski, Mateusz and Cistrone, Luca and Dechmann, Dina K. N. and Eldegard, Katrine and Fjelldal, Mari Aas and Froidevaux, Jérémy and Furmankiewicz, Joanna and Garin, Inazio and Hamel, Luke and Ibanez, Carlos and Jankowska-Jarek, Martyna and Juste, Javier and Korine, Carmi and Lesiński, Grzegorz and Leuchtmann, Maxime and Martinoli, Adriano and Mas, Maria and Mathews, Fiona and McKay, Reed April and Molenaar, Thijs and Morris, Colin and Nistreanu, Victoria and Olival, Kevin J. and Pereswiet-Soltan, Andrea and Péter, Áron and Phelps, Kendra and Pontier, Dominique and Pope, Lucy and Rebelo, Hugo and Preatoni, Damiano G. and Puig-Monserat, Xavier and Roche, Niamh and Ruczyński, Ireneusz and D. Sándor, Attila and Sørås, Rune and Spada, Martina and Toshkova, Nia and van der Kooij, Jeroen and Voigt, Christian C. and Wikar, Zuzanna and Zapart, Aneta and Zegarek, Marcin and Benítez-López, Ana},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/ecog.07663},
	keywords = {climate change, body size, Chiroptera, Allen's rule, Bergmann's rule, meta-analysis},
	pages = {e07663},
	file = {Full Text PDF:C\:\\Users\\maria\\Zotero\\storage\\SHDZKDXN\\Paltrinieri et al. - The effects of climate on bat morphology across space and time.pdf:application/pdf;Snapshot:C\:\\Users\\maria\\Zotero\\storage\\TMKK5DBV\\ecog.html:text/html},
}

@article{cohen_coronavirus_2023,
	title = {Coronavirus sampling and surveillance in bats from 1996-2019: a systematic review and meta-analysis},
	volume = {8},
	issn = {2058-5276},
	shorttitle = {Coronavirus sampling and surveillance in bats from 1996-2019},
	doi = {10.1038/s41564-023-01375-1},
	abstract = {The emergence of SARS-CoV-2 highlights a need for evidence-based strategies to monitor bat viruses. We performed a systematic review of coronavirus sampling (testing for RNA positivity) in bats globally. We identified 110 studies published between 2005 and 2020 that collectively reported positivity from 89,752 bat samples. We compiled 2,274 records of infection prevalence at the finest methodological, spatiotemporal and phylogenetic level of detail possible from public records into an open, static database named datacov, together with metadata on sampling and diagnostic methods. We found substantial heterogeneity in viral prevalence across studies, reflecting spatiotemporal variation in viral dynamics and methodological differences. Meta-analysis identified sample type and sampling design as the best predictors of prevalence, with virus detection maximized in rectal and faecal samples and by repeat sampling of the same site. Fewer than one in five studies collected and reported longitudinal data, and euthanasia did not improve virus detection. We show that bat sampling before the SARS-CoV-2 pandemic was concentrated in China, with research gaps in South Asia, the Americas and sub-Saharan Africa, and in subfamilies of phyllostomid bats. We propose that surveillance strategies should address these gaps to improve global health security and enable the origins of zoonotic coronaviruses to be identified.},
	language = {eng},
	number = {6},
	journal = {Nature Microbiology},
	author = {Cohen, Lily E. and Fagre, Anna C. and Chen, Binqi and Carlson, Colin J. and Becker, Daniel J.},
	month = jun,
	year = {2023},
	keywords = {China, Chiroptera, Humans, SARS-CoV-2, Animals, COVID-19, Phylogeny},
	pages = {1176--1186},
	file = {Texte intégral:C\:\\Users\\maria\\Zotero\\storage\\FVJPRDX7\\Cohen et al. - 2023 - Coronavirus sampling and surveillance in bats from 1996-2019 a systematic review and meta-analysis.pdf:application/pdf},
}

@article{poisot_guidelines_2023,
	title = {Guidelines for the prediction of species interactions through binary classification},
	volume = {14},
	copyright = {© 2023 The Author. Methods in Ecology and Evolution published by John Wiley \& Sons Ltd on behalf of British Ecological Society.},
	issn = {2041-210X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/2041-210X.14071},
	doi = {10.1111/2041-210X.14071},
	abstract = {The prediction of species interactions is gaining momentum as a way to circumvent limitations in data volume. Yet, ecological networks are challenging to predict because they are typically small and sparse. Dealing with extreme class imbalance is a challenge for most binary classifiers, and there are currently no guidelines as to how predictive models can be trained for this specific problem. Using simple mathematical arguments and numerical experiments in which a variety of classifiers (for supervised learning) are trained on simulated networks, we develop a series of guidelines related to the choice of measures to use for model selection, and the ways to assemble the training dataset. Neither classifier accuracy nor the area under the receiver operating characteristic curve (ROC-AUC) are informative measures for the performance of interaction prediction. The area under the precision-recall curve (PR-AUC) is a fairer assessment of performance. In some cases, even standard measures can lead to selecting a more biased classifier because the effect of connectance is strong. The amount of correction to apply to the training dataset depends on network connectance, on the measure to be optimized, and only weakly on the classifier. These results reveal that training machines to predict networks is a challenging task, and that in virtually all cases, the composition of the training set needs to be fine-tuned before performing the actual training. We discuss these consequences in the context of the low volume of data.},
	language = {en},
	number = {5},
	urldate = {2025-04-22},
	journal = {Methods in Ecology and Evolution},
	author = {Poisot, Timothée},
	year = {2023},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/2041-210X.14071},
	keywords = {machine learning, binary classification, ecological networks},
	pages = {1333--1345},
	annote = {MCC 
« Chicco and Jurman (2020) suggest using Matthews correlation coefficient (MCC) over F1, as a protection against over-inflation of predicted results » (Poisot, 2023, p. 1334)
« Boughorbel et al. (2017) recommend MCC over other measures of performance for imbalanced » (Poisot, 2023, p. 1334)

ROC/PR 
« Saito and Rehmsmeier (2015) established that the ROC-AUC is biased towards over-estimating performance for imbalanced data; on the contrary, the PR- AUC is able to identify classifiers that are less able to detect positive interactions correctly » (Poisot, 2023, p. 1335)


K 
« The κ measure (Landis \& Koch, 1977) establishes the extent to which two observers (the network and the prediction) agree » (Poisot, 2023, p. 1335)


Informedness
« Informedness (Youden, 1950) (also known as bookmaker informedness or the true skill statistic) is TPR + TNR − 1, where TPR = tp ∕ (tp + fn) and TNR = tn ∕ (tn + fp). Informedness can be used to find the optimal cut-point in thresholding analyses (Schisterman et al., 2005); indeed, the maximal informedness corresponds to the point on the ROC curve that is closest to the perfect classifier point. » (Poisot, 2023, p. 1335)
},
	file = {Full Text PDF:C\:\\Users\\maria\\Zotero\\storage\\AIRASACD\\Poisot - 2023 - Guidelines for the prediction of species interactions through binary classification.pdf:application/pdf},
}

