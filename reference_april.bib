	author = {Mora, Camilo and McKenzie, Tristan and Gaw, Isabella M. and Dean, Jacqueline M. and von Hammerstein, Hannah and Knudson, Tabatha A. and Setter, Renee O. and Smith, Charlotte Z. and Webster, Kira M. and Patz, Jonathan A. and Franklin, Erik C.},
	month = sep,
