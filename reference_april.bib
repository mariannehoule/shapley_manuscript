	month = dec,
	year = {2024},
	keywords = {SARS virus, Viral infection, Epidemiology, Viral epidemiology},
	pages = {10705},
	annote = {« we present a phylogenetic analysis suggesting a likely origin for SARSCoV-2 in Rhinolophus spp. bats. » (Latinne et al., 2024, p. 1)


},
